# Postgres. `npx create-db` provisions a free Prisma Postgres in seconds.
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Verifies the user.created / user.updated / user.deleted webhook at
# /api/webhooks/clerk. Copy it from the endpoint's page in the Clerk dashboard.
CLERK_WEBHOOK_SIGNING_SECRET=

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Bearer token the cron routes in vercel.json check before doing any work.
# Without it they are open in development and closed in production.
CRON_SECRET=

# debug | info | warn | error — defaults to debug.
LOG_LEVEL=info
