/// A message addressed to one person. The same domain event fans out to one
/// Notification per recipient plus a single Activity row for the feed.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String?
  type    EventType

  title String
  body  String?
  /// Where tapping the notification should land.
  href  String?
  data  Json?

  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([groupId])
}

/// A browser push endpoint registered by the service worker. `failureCount` lets
/// the sender prune endpoints the push service has started rejecting.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent    String?
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@index([userId])
}
