/// A shared ledger. All balances are computed in the group's `currency`.
model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType @default(OTHER)

  /// Lightweight identity so groups are distinguishable at a glance in a list.
  emoji    String @default("🧾")
  colorKey String @default("indigo")

  currency String @default("INR")

  /// When true, balances are collapsed with min-cash-flow before being shown.
  simplifyDebts Boolean @default(true)

  createdById String
  createdBy   User   @relation("GroupCreatedBy", fields: [createdById], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  members     GroupMember[]
  inviteCodes InviteCode[]
  expenses    Expense[]
  settlements Settlement[]
  categories  Category[]
  recurring   RecurringExpense[]
  activities  Activity[]

  @@index([createdById])
  @@index([deletedAt])
}

/// Membership is soft: `leftAt` retires a member without erasing their history,
/// because past expenses still reference them.
model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     MemberRole @default(MEMBER)
  /// Per-group display override, e.g. "Amma" instead of the Clerk name.
  nickname String?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([groupId, userId])
  @@index([userId, leftAt])
  @@index([groupId, leftAt])
}

/// One row backs both join paths: the short `code` typed by hand and the longer
/// `token` embedded in a copyable link.
model InviteCode {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  code  String @unique
  token String @unique

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  expiresAt DateTime?
  maxUses   Int?
  useCount  Int       @default(0)
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([groupId, revokedAt])
}
