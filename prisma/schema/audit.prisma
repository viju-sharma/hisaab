/// Immutable system-of-record for every mutation. Written inside the same
/// transaction as the change it describes (see lib/observability/audit.ts), and
/// carries the request's `traceId` so a row can be tied back to the full log
/// trace of the gesture that produced it. Never updated, never deleted.
model AuditLog {
  id String @id @default(cuid())

  traceId   String
  requestId String?

  actorUserId  String?
  actor        User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorClerkId String?

  groupId String?

  action     AuditAction
  entityType String
  entityId   String

  before Json?
  after  Json?
  /// Field-level changes only, for a readable history without diffing two blobs.
  diff   Json?

  route     String?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([entityType, entityId])
  @@index([groupId, createdAt])
  @@index([actorUserId, createdAt])
}
